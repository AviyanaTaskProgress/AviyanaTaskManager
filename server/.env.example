# Supabase project settings (Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SERVICE ROLE key -- server-side ONLY. Never expose this to the frontend/browser.
# This key bypasses Row Level Security, so all authorization must be
# enforced in this backend's middleware (see src/middleware/auth.ts).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used only to verify incoming user JWTs (issued by Supabase Auth)
SUPABASE_JWT_SECRET="your-jwt-secret"

PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000"
